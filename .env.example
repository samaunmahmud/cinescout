# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.

# Required: the PostgreSQL password (any long random string).
DB_PASSWORD=

# The port the web app is served on.
WEB_PORT=8080

# Let anyone register? Turn off once your accounts exist, for a deployment that should not be public.
REGISTRATION_OPEN=true

# Per-user limits on the AI and lookup features, per-address limits on logins and sign-ups (see README,
# "Rate limits"). On by default; set to false only for a trusted, single-user install.
RATE_LIMITS_ENABLED=true

# OpenStreetMap's services want a User-Agent with a way to reach whoever runs this deployment.
OSM_USER_AGENT=CineScout/0.1 (+https://github.com/samaunmahmud/cinescout)

# Optional: IBM watsonx.ai for scene analysis, scouting assessments and outreach emails.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Requests per second your plan allows (2 on the free Lite plan).
WATSONX_MAX_REQUESTS_PER_SECOND=2

# Optional: Parallel web search, for scouting (together with watsonx.ai).
PARALLEL_API_KEY=

# Optional: videos of each venue. A Google Cloud API key with the YouTube Data API v3 enabled (free quota:
# about 100 searches a day; results are cached per venue for a week).
YOUTUBE_API_KEY=

# Optional: a map tile provider for real traffic (OpenStreetMap's own server is for light use).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional, with `docker compose --profile https up`: the public host name Caddy gets a certificate for.
DOMAIN=
